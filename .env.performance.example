# Referencia: el preparador genera valores aleatorios en artifacts/performance/<id>/compose.env.
# No copiar conexiones reales. La configuración no admite DATABASE_URL del host.
PERF_DB_PASSWORD=generated_local_only
PERF_AUTH_SECRET=generated_local_only
PERF_PAYMENT_SECRET=generated_local_only
PERF_RUN_ID=generated_uuid
PERF_EXPERIMENT_ID=generated_uuid_per_execution
PERF_CATALOG_SIZE=30
PERF_CONCURRENCY=unspecified

# Desactivado por defecto. El runner habilita temporalmente ambas variables
# solo con --browser --synthetic-id G-ID_LAB y autorización de ejecución.
PERF_BROWSER_ANALYTICS=false
PERF_GA4_SYNTHETIC_MEASUREMENT_ID=
