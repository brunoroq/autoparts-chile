# Reutiliza dependencias locales ya verificadas, sin descargas durante el build.
FROM autoparts-performance:local
USER root
WORKDIR /app
COPY --chown=node:node . .
ENV DATABASE_URL=postgresql://fixture:fixture@127.0.0.1:1/offline_build_test
ENV DIRECT_URL=postgresql://fixture:fixture@127.0.0.1:1/offline_build_test
ENV NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1 ANALYTICS_ENABLED=false
RUN NEXTAUTH_SECRET=build_fixture_only_012345678901234567890123456789 npm run build && chown -R node:node /app/.next /app/src/generated
USER node
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
