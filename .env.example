# Valores de ejemplo. Copiar a .env y reemplazar la contraseña local.
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=autoparts
POSTGRES_PORT=5432
# Mantener usuario, contraseña, puerto y base sincronizados con los valores anteriores.
# Codificar caracteres especiales de la contraseña para una URL.
DATABASE_URL=postgresql://autoparts:replace_with_local_password@127.0.0.1:5432/autoparts?schema=public
# Opcional: base local aislada para pruebas; el nombre debe terminar en _test.
# Si se omite, los scripts de prueba derivan autoparts_catalog_test.
# TEST_DATABASE_URL=postgresql://autoparts:replace_with_local_password@127.0.0.1:5432/autoparts_perf_1000_test?schema=public
# Local: origen exacto del navegador, incluido el puerto.
# Vercel Production: NEXTAUTH_URL=https://autoparts-chile.vercel.app
# Debe coincidir con el dominio estable; no usar el nombre antiguo ni una URL de preview.
NEXTAUTH_URL=http://localhost:3000
# Generar un secreto aleatorio local de al menos 32 bytes; no usar este marcador.
NEXTAUTH_SECRET=replace_with_random_local_secret

# Pagos académicos: simulador predeterminado. Nunca producción.
PAYMENT_PROVIDER=simulated
WEBPAY_ENVIRONMENT=integration
# Solo Webpay: generar 32 bytes aleatorios en hexadecimal (64 caracteres).
# Conservar este secreto para recuperar tokens después de reiniciar.
PAYMENT_TOKEN_SECRET=replace_with_64_hex_characters

# Etapa 5: todo opt-in. IDs públicos de medición, nunca API secrets.
ANALYTICS_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_SYNTHETIC_MEASUREMENT_ID=
GA4_DEBUG=false
WEB_VITALS_ENABLED=false
RESOURCE_METRICS_ENABLED=false
RESOURCE_SAMPLE_MS=15000
APP_ENV=local
TRAFFIC_KIND=human
# Generar un UUID nuevo por experimento; no usar nombres/correos.
EXPERIMENT_ID=baseline
CATALOG_SIZE=30
EXPERIMENT_CONCURRENCY=unspecified

# Preparación Vercel/Neon: solo ejemplos, sin cambios en la conexión Docker.
# Cloud: DB_POOL_MAX=2 (local conserva 5 si se omite).
# DB_POOL_MAX=2
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=10000
# CLI: DIRECT_URL opcional; no es necesaria para prisma generate durante build.
# Para Neon usar un archivo privado EXCLUSIVO .env.neon.local.
# DIRECT_URL=postgresql://role:replace_password@ep-example.us-east-1.aws.neon.tech/autoparts_public?sslmode=verify-full
# VERCEL es suministrada por la plataforma; no definirla en el .env local.
