{
  "name": "autoparts-chile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run db:validate",
    "check:http": "node scripts/check-http.mjs",
    "test": "tsx --test tests/catalog.test.ts tests/auth.test.ts tests/checkout.test.ts tests/analytics.test.ts tests/deployment.test.ts",
    "test:auth:compat": "node scripts/check-auth-compat.mjs",
    "test:auth:prepare": "tsx scripts/prepare-auth-tests.ts",
    "test:auth:integration": "tsx --test tests/auth.integration.test.ts",
    "test:auth:server": "tsx scripts/start-auth-test-server.ts",
    "test:auth:http": "tsx --test tests/auth.http.test.ts",
    "test:auth:restart": "tsx scripts/check-auth-restart.ts",
    "test:integration": "tsx --test tests/catalog.integration.test.ts",
    "test:prepare": "tsx scripts/prepare-test-db.ts",
    "test:http": "tsx --test tests/catalog.http.test.ts",
    "test:http:error": "tsx --test tests/catalog.error-http.test.ts",
    "test:browser": "playwright test",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx scripts/seed-test-db.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx scripts/check-db.ts",
    "test:checkout:prepare": "tsx scripts/prepare-checkout-tests.ts",
    "test:checkout:integration": "tsx --test tests/checkout.integration.test.ts",
    "test:checkout:server": "tsx scripts/start-checkout-test-server.ts",
    "test:checkout:http": "tsx --test tests/checkout.http.test.ts",
    "test:checkout:restart": "tsx scripts/check-checkout-restart.ts",
    "metrics:export": "tsx scripts/export-metrics.ts",
    "metrics:docker": "tsx scripts/observe-docker.ts",
    "test:analytics:prepare": "tsx scripts/prepare-analytics-tests.ts",
    "test:analytics:integration": "tsx --test tests/analytics.integration.test.ts",
    "test:analytics:server": "tsx scripts/start-analytics-test-server.ts",
    "metrics:manifest": "tsx scripts/experiment-manifest.ts",
    "test:observability": "tsx scripts/check-observability.ts",
    "cloud:migrate": "tsx scripts/cloud-migrate.ts",
    "cloud:bootstrap": "tsx scripts/cloud-bootstrap.ts",
    "test:deployment:integration": "tsx --test tests/deployment.integration.test.ts",
    "test:deployment": "tsx scripts/deployment-checks.ts",
    "check:local-preservation": "tsx scripts/check-local-preservation.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "transbank-sdk": "6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
